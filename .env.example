# Project TITAN — MES Oracle Real PoC (REV.5)
# Copy to .env and fill in values. NEVER commit .env to Git.

# Oracle connection (read-only account recommended)
MES_ORACLE_HOST=
MES_ORACLE_PORT=1521
MES_ORACLE_SERVICE=
MES_ORACLE_USER=
MES_ORACLE_PASSWORD=

# Optional: full connect string override (host:port/service)
# MES_ORACLE_CONNECT_STRING=

# Read-only SELECT queries (max 20 rows) — DBA must provide actual table/view names
# Copy templates from scripts/mes-poc/queries/*.sql

# MES_ORACLE_SQL_PRODUCT=SELECT MASVNO, MASVNM, MASSIZ, MASCOLM FROM YOUR_PRODUCT_VIEW WHERE ROWNUM <= 20
# MES_ORACLE_SQL_CUSTOMER=SELECT VNDCOD, VNDKNM FROM YOUR_VENDOR_VIEW WHERE ROWNUM <= 20
# MES_ORACLE_SQL_INBOUND=SELECT SADDAT, SADQTY, SADLOT, SADVLO FROM YOUR_INBOUND_VIEW WHERE ROWNUM <= 20

# Vite dev server URL for Electron (optional)
# VITE_DEV_SERVER_URL=http://localhost:5173
