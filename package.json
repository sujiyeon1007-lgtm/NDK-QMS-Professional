{
  "name": "ndk-qms-professional",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "verify:data-engine": "npx vite-node scripts/verify-titan-data-engine.mjs",
    "verify:workflow-engine": "npx vite-node scripts/verify-titan-workflow-engine.mjs",
    "verify:workflow-integration": "npx vite-node scripts/verify-workflow-integration.mjs",
    "verify:master-data-integration": "npx vite-node scripts/verify-master-data-integration.mjs",
    "verify:rc1-company-import": "npx vite-node scripts/verify-rc1-company-excel-import.mjs",
    "verify:rc1-company-import-browser": "npx vite-node scripts/verify-rc1-company-import-browser.mjs",
    "verify:rc1-demo-dashboard-sync": "npx vite-node scripts/verify-rc1-demo-dashboard-sync.mjs",
    "verify:qr-workflow-v17": "npx vite-node scripts/verify-qr-workflow-v17.mjs",
    "verify:home-workspace": "npx vite-node scripts/verify-home-workspace.mjs",
    "verify:quality-workspace": "npx vite-node scripts/verify-quality-workspace.mjs",
    "verify:control-room": "npx vite-node scripts/verify-control-room.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:beta": "vite preview --port 4175 --host",
    "beta:sync": "git push origin presentation && git checkout beta-demo && git merge presentation && git push origin beta-demo && git checkout presentation",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build:electron": "vite build --mode electron",
    "electron:preview": "npm run build:electron && node scripts/run-electron-prod.cjs",
    "electron:build": "npm run build:electron && node scripts/run-electron-prod.cjs",
    "dist:win": "npm run build:electron && electron-builder --win --x64",
    "dist:portable": "npm run build:electron && electron-builder --win portable --x64",
    "verify:v11-master-sqlite": "npx vite-node scripts/verify-v11-master-sqlite-persist.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "dotenv": "^16.4.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "playwright": "^1.50.1",
    "vercel": "^54.18.7",
    "vite": "^8.1.0",
    "wait-on": "^8.0.2"
  },
  "optionalDependencies": {
    "oracledb": "^6.8.0",
    "better-sqlite3": "^11.9.1"
  },
  "build": {
    "appId": "com.ndk.titan.qms",
    "productName": "Project TITAN",
    "copyright": "Copyright © NDK",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Project-TITAN-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Project-TITAN-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Project TITAN",
      "artifactName": "Project-TITAN-${version}-setup.exe"
    }
  }
}
